; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2]
type = DisplayToClipboard
trigger1 = 1
text = "Var = %d Var = %d P2Dist X:%f, P2Dist Y:%f, Pos Y:%f"
params = var(46), var(45), P2BodyDist X, P2BodyDist Y, Pos Y

[State 0,wall bounce helper]
type = Helper
triggerall = !numhelper(1013)
trigger1 = p2stateno = 1012
trigger1 = p2movetype = H && enemy,time = [1,1]
ID = 1013
pos = -10,-80
postype = p2
stateno = 1013
facing = -1
helpertype = normal
name = "wall bounce helper"
keyctrl = 0
ownpal = 1
ignorehitpause = 1
supermovetime = -1

[State 0, BY]
type = NotHitBy
trigger1 = P2movetype= H
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
ignorehitpause = 1

[State 0, BY]
type = NotHitBy
triggerALL = var(22)= 1
trigger1 = movetype!= H
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
ignorehitpause = 1

[State 0, PowerAdd]
type = PowerAdd
trigger1 = movetype= H && TIME = 1
value = 15
ignorehitpause = 1


[State 0,palette routing (noop)]
type = NULL
trigger1 = !var(18)
source = 1,1
dest = 1,1
ignorehitpause = 1


[State 0, VarSet]
type = NULL
trigger1 = !var(18)
v = 18    ;fv = 10
value = 1
 
[State -3, Afterimage on success]
type = AfterImage
trigger1 = 0
trigger1 = numhelper(8230)=2
time = -1
trans = add
length = 10
timeGap = 1
frameGap = 1
palbright = 30,30,30
palcontrast = 200,100,180
paladd = 0,0,0
palmul = .75,.75,.75
ignorehitpause = 1

[State -2, phantom helper]
type = Helper
trigger1 = 0
trigger1 = gametime%60=0
trigger1 = random <= 300
stateno = 30007
id = 30007
name = "phantom helper"
pos = 0,0
postype = P1
helpertype = normal
keyctrl = 0
ownpal = 1
pausemovetime = 999999
supermovetime = 999999
ignorehitpause = 1
persistent = 0


[State -2, phantom helper]
type = Helper
trigger1 = 0
trigger1 = numhelper(8230)=0
stateno = 8230
id = 8230
name = "phantom helper"
pos = 0,0
postype = P1
helpertype = normal
keyctrl = 0
ownpal = 1
pausemovetime = 999999
supermovetime = 999999
ignorehitpause = 1
persistent = 0




[State -2, Hit Detection]
type=varset
trigger1= movecontact!=1
var(30)=2
ignorehitpause=1

[State -2, Sparks]
type=helper
triggerall= movecontact=1 && var(30)=1
trigger1= movehit=1 && numenemy
trigger1= var(33)=12000  
trigger2= moveguarded=1 && numenemy
trigger2= var(34)=12100 
helpertype=normal
stateno=ifelse(moveguarded, var(34), var(33))
ID=12000
name="Spark"
postype=p1
pos= ifelse(p2dist x<0, (ceil(p2dist x)), ifelse(p2dist x<var(35), ceil(p2dist x), var(35))), var(36)
facing= ifelse((p2bodydist x >=-5),-1,1);-1;enemynear,facing
ownpal=1
pausemovetime=65535
supermovetime=65535
ignorehitpause=1
size.xscale =1
size.yscale =1

[State -2, Hit Detection]
type=varrangeset
trigger1= movetype=I
trigger2= movetype=H && time
first=30
last=36
value=-1
ignorehitpause=1

[State -2, Hit Detection]
type=varadd
trigger1= var(30)>0
var(30)=-1
ignorehitpause=1

[State -1, Taunt]
type = selfState
value = 1950;195
triggerall = !var(59) 
trigger1 = command = "s"
trigger1 = movetype = H
;trigger1 = ctrl
