[State 1000, HitDef block]
type=HitDef
trigger1 = AnimElem = 3 || AnimElem = 5 || AnimElem = 7 || AnimElem = 9
attr=S, SA
damage=20
priority=4, Hit
animtype=Hard
guardflag=MA
hitflag=MAF
pausetime = 0, 7
guard.pausetime = 0, 7
sparkno = -1 + 0*(var(33):=12000)
