trigger1 = !Time
anim = 13016
sprPriority = -3
posType = P1
pos = -20,-80
scale = 1,1
pauseMoveTime = -1
superMoveTime = -1
vfacing = -1
ownPal = 1

[State 40, End]
type = ChangeState
trigger1 = !AnimTime
value = 42
ctrl = 1
;====================<Jumping>====================
;jump
[StateDef 42]
type = A
physics = N
moveType = I
sprPriority = 1

[State 50, ChangeAnim]
type = ChangeAnim
trigger1 = !Time
value = ifElse(!vel x , 41, ifElse(vel x > 0, 42, 43)) 
persistent = 0

[State 50, Grounded Frame]
type = PosFreeze
trigger1 = Time < 1 && PrevStateNo = 40
value = 1

[State 50, Gravity]
type = Gravity
trigger1 = Time >= 1 || PrevStateNo != 40

[State 50, Landing]
type = ChangeState
trigger1 = pos y > -vel y
value = 52

;air
