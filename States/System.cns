;Evasive dash
[Statedef 700]
type    = S
movetype= I
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 700
sprpriority = -1

[State 700, SFX]
type = Playsnd
trigger1 = time = 3
value = 1,3

[State 700, Voice]
type = Playsnd
trigger1 = time = 3
value = ifElse(Random < 500, 0, 701), 0
channel = 0

[State 710, Start Roll]
type = VelSet
trigger1 = AnimElem = 2
x = 12

[State 700, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0

[State -3, Afterimage on success]
type = AfterImage
trigger1 = time=0
time = 20
trans = add
length = 10
timeGap = 1
frameGap = 1
palbright = 30,30,30
palcontrast = 200,100,180
paladd = 0,0,0
palmul = .75,.75,.75

[State 0,HELL]
type = NotHitBy
trigger1 = time = 0
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
time = 30
ignorehitpause = 1

[State 700, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

