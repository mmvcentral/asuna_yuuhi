;super jump
[Statedef 123]
type = A
movetype = I
physics = N
anim = 40
velset = 0,0
ctrl = 0

[State 123, reset]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 123, Direction]
type = varset
trigger1 = !var(59)
sysvar(1) = Ifelse(!time, 0, Ifelse(command = "holdfwd", 1, Ifelse(command = "holdback", -1, sysvar(1))))
[State 123, Direction]
type = varset
trigger1 = var(59)
sysvar(1) = Ifelse((enemynear, movetype != A || backedgebodydist <= 10), 1, Ifelse((enemynear, movetype = A), -1, 0))


[state 123, playsnd]
type = playsnd
trigger1 = !AnimTime
value = s110,0
channel = 4
[State 123, Jump Sound]
type = PlaySnd
trigger1 = !AnimTime
value = 41, 0
[State 123, Dust Helper]
type = Helper
trigger1 = !AnimTime
helperType = Normal
stateNo = 8100
ID = 8100
name = "Jump Dust"
posType = P1
ownPal = 1

[State 123, velset]
type = VelSet
trigger1 =!animtime
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)*1.2


[State 123, Change]
type = ChangeState
trigger1 = !animtime
value = 50
ctrl = 1
;=====================<HIT GROUND(BOUNCE)>===================
;Hit Ground
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, ChangeAnim]
type = ChangeAnim
trigger1 = !var(59)
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, ChangeAnim]
type = ChangeAnim
trigger1 = var(59)
value = 120 + (statetype = C) + (statetype = A)*2
elem = 1

[State 120, StateTypeSet]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, StateTypeSet]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, StateTypeSet]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, StateTypeSet]; ---- S to C
type = StateTypeSet
triggerall = statetype = S
triggerall = !var(59)
trigger1 = command = "holddown"
statetype = C
physics = C

[State 120, StateTypeSet]; ---- C to S
type = StateTypeSet
triggerall = statetype = C
triggerall = !var(59)
trigger1 = command != "holddown"
statetype = S
physics = S

[State 120, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, StateTypeSet]; ---- Hi to Lo AI using
Type = StateTypeSet
TriggerAll = Var(59) > 0
TriggerAll = StateType = S
Trigger1 = Enemy,NumProj > 0 || Enemy,NumHelper > 0
Trigger2 = EnemyNear,HitDefAttr = A,AA
Trigger2 = EnemyNear,Vel Y = 0
Trigger3 = EnemyNear,HitDefAttr = C,AA || EnemyNear,HitDefAttr = SCA,AP
Trigger4 = EnemyNear,HitDefAttr = S,AA
Trigger4 = EnemyNear,Time < 8
Trigger4 = EnemyNear,Vel Y <= 0
Trigger5 = EnemyNear,StateType != S
Trigger5 = EnemyNear,HitDefAttr = S,AA
Trigger5 = EnemyNear,Time >= 8
Trigger5 = EnemyNear,Vel Y <= 0
StateType = C
Physics = C

[State 120, StateTypeSet]; ---- Lo to Hi AI using
Type = StateTypeSet
TriggerAll = Var(59) > 0
TriggerAll = StateType = C
Trigger1 = EnemyNear,HitDefAttr = A,AA
Trigger1 = EnemyNear,Vel Y != 0
Trigger2 = EnemyNear,HitDefAttr = S,AA
Trigger2 = EnemyNear,Time >= 8
Trigger2 = EnemyNear,StateType = S
Trigger3 = EnemyNear,HitDefAttr = S,AA
Trigger3 = EnemyNear,Time < 8
Trigger3 = EnemyNear,Vel Y > 0
Trigger4 = EnemyNear,StateType != S
Trigger4 = EnemyNear,HitDefAttr = S,AA
Trigger4 = EnemyNear,Time >= 8
Trigger4 = EnemyNear,Vel Y > 0
StateType = S
Physics = S

[State 120, ChangeState]; ---- Stop Guarding
type = ChangeState
TriggerAll = !var(59)
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

[State 120, ChangeState]; ---- Stop Guarding AI using
Type = ChangeState
TriggerAll = Var(59) > 0
Trigger1 = !EnemyNear(floor(fvar(36))),Numproj
Trigger1 = ifelse((NumEnemy=2 && EnemyNear(0),alive && EnemyNear(1),alive),(!EnemyNear(floor(fvar(36))+1),Numproj),1)
Trigger1 = !InGuardDist
Trigger1 = !(Facing*(EnemyNear,Facing)*P2Dist X >0 && (Abs(P2Dist X) <= 45) && P2MoveType=A)
Value = 140

