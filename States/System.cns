
;---------------------------------------------------------------------------
;Round timeout end
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, Snd]
type = playsnd
trigger1 = !time
value = 170,ifelse(numenemy,0+random%2,1)
channel = 0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
;---------------------------------------------------------------------------
;win pose
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = NumEnemy
TriggerAll= Anim != 4035
trigger1 = !Time && MatchOver
value = 181 + (random%2)

[State 180, 1]
type = ChangeState
trigger1 = NumEnemy
TriggerAll= Anim != 4035
trigger1 = !Time && !MatchOver
value = 181

[State 180, 1]
type = ChangeState
TriggerAll= Anim != 4035
trigger1 = !NumEnemy
trigger1 = !Time
value = 181

;---------------------------------------------------------------------------
;Win pose 1
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, Voice]
type = playsnd
trigger1 = numenemy
trigger1 = !time&&matchover
value = 180,ifElse(Life < LifeMax/2, 0+random%2, 1)
channel = 0
[State 181, Voice]
type = playsnd
trigger1 = numenemy
trigger1 = !time&&!matchover
value = 180,2+random%3
channel = 0
[State 181, Voice]
type = playsnd
trigger1 = !numenemy
trigger1 = !time
value = 180,3
channel = 0

[State 181, Snd]
type = playsnd
trigger1 = animelem=6
value = 192,0

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = time = [0, 300]
flag = roundnotover

;Win pose 2
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 182, Yui]
type = helper
trigger1 = anim=182 && animelem=7 && !numhelper(184)
helpertype = normal
stateno = 184
ID = 184
name = "Yui"
postype = back
pos = -100, 0
facing = 1
ownpal = 1
size.shadowoffset = 2
ownpal = 1

[State 182, Voice Pattern]
type = VarRandom
trigger1 = !time
v = 10
range = 0,1
ignorehitpause = 1
persistent = 0

[State 182, Voice]
type = playsnd
trigger1 = anim=182 && animelem=7
value = 181,0+Var(10)
channel = 0

[State 182, Snd]
type = playsnd
trigger1 = anim=182 && animelem=6
value = 192,0

[State 182, ChangeAnim]
type = changeanim
triggerall = anim != 183
trigger1 = numhelper(184)
trigger1 = helper(184), rootdist x <= 4
value = 183

[State 182, PosAdd]
type=PosAdd
trigger1 = Anim=183 && animelem = 2
x=15
[State 182, PosAdd]
type=PosAdd
trigger1 = Anim=183 && animelem = 3
x=15
[State 182, PosAdd]
type=PosAdd
trigger1 = Anim=183 && animelem = 4
x=6

[State 182, Snd]
type = PlaySnd
trigger1 = Anim=183 && AnimElem = 2
value = 105, 0

[State 182, Voice]
type = playsnd
trigger1 = var(10)
trigger1 = anim=183 && animelem=5
value = 181,2
channel = 0

[State 182, AssertSpecial]
type = AssertSpecial
trigger1 = time = [0, 300]
trigger2 = Anim = 182
trigger3 = Anim = 183 && AnimElem = 6, < 0
flag = roundnotover
;---------------------------------------------------------------------------
;intro 1
