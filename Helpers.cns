;lunge glow
[Statedef 3080]
physics  = N
anim = 1305
ctrl = 0
velset=0,0
sprpriority=4

[State 1205, FreezeAnim from hit pause]
type = ChangeAnim
triggerall = animelemtime(5)<=0
trigger1 = Parent,HitPauseTime
value = anim
elem = animelemno(0)
ignorehitpause=1
[State 1205, FreezeAnim from hit pause]
type = ChangeAnim
triggerall = animelemtime(5)>0&&animelemtime(7)<0
trigger1 = Parent,HitPauseTime
value = anim
elem = animelemno(0)-1
ignorehitpause=1

[State 1205, transparency]
type = Trans
trigger1 =animelemtime(2)<0
trans = addalpha
alpha = 240,256
ignorehitpause =1
[State 1205, transparency]
type = Trans
trigger1 =animelemtime(2)>=0&&animelemtime(3)<0
trans = addalpha
alpha = 200,256
ignorehitpause =1
[State 1205, transparency]
type = Trans
trigger1 =animelemtime(3)>=0&&animelemtime(4)<0
trans = addalpha
alpha = 120,256
ignorehitpause =1
[State 1205, transparency]
type = Trans
trigger1 =animelemtime(4)>=0&&animelemtime(5)<0
trans = addalpha
alpha = 80,256
ignorehitpause =1
[State 1205, transparency]
type = Trans
trigger1 =animelemtime(5)>=0&&animelemtime(6)<0
trans = addalpha
alpha = 60,256
ignorehitpause =1
[State 1205, transparency]
type = Trans
trigger1 =animelemtime(6)>=0
trans = addalpha
alpha = 40,256
ignorehitpause =1

[State 1205, scale]
type = VarAdd
triggerall = Time > 4
trigger1 = !(Parent,HitPauseTime)
var(1) = 1

[State 1205, scale]
type = AngleDraw
trigger1 = 1
scale = 2-(var(1)*0.125),6+(var(1)*0.25)

[State 1205, facing]
type = AngleSet
trigger1 = !Time
value = -35

[State 1205, lock bind]
type = BindToRoot
trigger1 =1
pos = ceil(190 * const(size.xScale)), ceil(-500 * const(size.yScale))
ignorehitpause =1
[State 1205, shadow cleanup]
type = AssertSpecial
Trigger1 = 1
flag = noshadow
ignorehitpause =1
[State 1205, dissipate fade]
type = destroyself
trigger1 =root,stateno!=3020
trigger2 =root,Movetype=H
trigger3 =!animtime
