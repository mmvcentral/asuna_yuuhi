;core glow
[Statedef 8230]
type     = S
movetype = I
physics  = S
juggle   = 0
velset   = 0,0
ctrl     = 0
sprpriority = 33

[State 77, nhb]
type=nothitby
trigger1= 1
value=SCA

[State 77, noshadow]
type=assertspecial
trigger1=1
flag=noshadow

[State 77, bind]
type=bindtoroot
trigger1=gametime%2
pos = 0,0
facing=1

[State 300, transparency]
type = Trans
trigger1 =1
trans = addalpha
alpha = 100,256
ignorehitpause =1

[State 0, PalFX]
type = PalFX
trigger1 = Time > 0
time = 2
add = 200,100,180
mul = 156,156,156
invertall = 0
color = 256

[State -3, Afterimage on success]
type = AfterImage
trigger1 = 0
time = -1
trans = add
length = 10
timeGap = 1
frameGap = 1
palbright = 30,30,30
palcontrast = 200,100,180
paladd = 0,0,0
palmul = .75,.75,.75
ignorehitpause = 1

[state ]
type=changeanim
trigger1=selfanimexist(root,anim)
value=root,anim
elem=root,animelemno(0)
;---------------------------------------------------------------------------
;rgbdetach
[Statedef 30007]
type    = U
movetype= U
physics = U
ctrl    = 0
sprpriority = -20

[state ]
type=changeanim
trigger1=selfanimexist(root,anim)
value=root,anim
elem=root,animelemno(0)

[State NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
ignorehitpause = 1

[State 0, Turn]
type = Turn
trigger1 = facing!=root,facing

[State PalFXWiz]
type = PalFX
trigger1 = 1
time = 1
add = 0,0,0
mul = IfElse(random <= 499,0,256),IfElse(random <= 499,0,256),0
sinadd = 0,0,0,1
invertall = 0
color = 256

[State 321, shadow cleanup]
type = AssertSpecial
Trigger1 = 1
flag = noshadow
ignorehitpause =1

[State Trans]
type = Trans
trigger1 = 1
trans = add
alpha = 256,256
ignorehitpause = 1
persistent = 1

[State BindToRoot]
type = BindToRoot
trigger1 = 1
pos = 0,0
ignorehitpause = 1

[State VarRandom]
type = VarRandom
trigger1 = 1
v = 0
range = -3,3
ignorehitpause = 1
persistent = 1

[State VarRandom]
type = VarRandom
trigger1 = 1
v = 1
range = -2,2
ignorehitpause = 1
persistent = 1

[State Offset]
type = Offset
trigger1 = time%2=0
x = var(0)
y = var(1)
;-----------------------------------------------------------------------------
[State self-destruct helper]
type = DestroySelf
trigger1 = time >=60
