;------------------------------------------------------------------------------
;Jump state id placeholder
[StateDef 1]
type = S
physics = S
moveType = I
sprPriority = 2
ctrl = 0

[State 0, Close range offense]
type = ChangeState
trigger1 = 1
value = IfElse(random >= 499,IfElse(random <= 499,200,410),IfElse(random <= 499,3200,1200))
;------------------------------------------------------------------------------
;AI walk state
[StateDef 21]
type = S
physics = S
moveType = I
anim = 20
sprPriority = 2
ctrl = 0

[State 0, turn] ; lock facing toward P2 when far
type = turn
trigger1 =Time>=50&& p2dist x < -18
value =1

[State 20, VelSet]
type = VelSet
trigger1 = 1
x = const(velocity.walk.fwd.x)

[State 0, BY]
type = NotHitBy
trigger1 = P2movetype= A
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
ignorehitpause = 1

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = p2dist x=[-60,60]
trigger2 = roundstate = 3
value = 0
ctrl = 1

[State 0, React to enemy attack]
type = ChangeState
trigger1 = p2dist x=[-150,150]
triggerall = statetype!= A
trigger1 = P2movetype=a
value = IfElse(random >= 499,IfElse(random <= 499,700,710),IfElse(random <= 499,1500,1700))
ignorehitpause = 1

;=============<Running>====================
;run
[Statedef 102]
type    = S
movetype = I
physics = S
ctrl = 0
VelSet = 0,0

[State 100, ChangeAnim]
type = ChangeAnim
trigger1 = !Time
value = 100

[State 100, Velocity]
type = VelSet
trigger1 = AnimElem = 2 >= 0
x = Const(velocity.run.fwd.x)

[State 100, Change to Run Stop]
type=ChangeState
trigger1 = var(59) && (p2movetype = A || p2dist x < 80) && Time >= 10
value=101
ctrl=0

[State 100, 2] ;Block run decay to walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 110, Dust Helper]
type = Helper
trigger1 = AnimElem = 2
helperType = Normal
stateNo = 8103
ID = 8100
name = "dust helper"
posType = P1
pauseMoveTime = 255
superMoveTime = 255
ownPal = 1

[State 105, Starting Step snd]
type = PlaySnd
trigger1 = !Time
value = 102, 0
channel = 5

[State 105, Step snd]
type = PlaySnd
trigger1 = AnimElem = 4 || AnimElem = 7
value = 100,Ifelse((AnimElem = 7),1,0)
channel = 5

[State 0, React to enemy attack]
type = ChangeState
trigger1 = p2dist x=[-150,150]
triggerall = statetype!= A
trigger1 = P2movetype=a
value = IfElse(random >= 499,IfElse(random <= 499,700,710),IfElse(random <= 499,1500,1700))
ignorehitpause = 1

[State 100, 4]
type = ChangeState
trigger1 = p2dist x=[-50,50]
trigger2 = roundstate = 3
value = 0
ctrl = 1
;---------------------------------------------------------------------------
;AI land state
[StateDef 652]
type = S
physics = S
moveType = I
anim = 47
ctrl = 0
velSet = 0,0
sprPriority = 1

[State 0, Turn]
type = Turn
trigger1 = facing = enemy,facing
ignorehitpause = 1

[State 52, PosSet]
type = PosSet
trigger1 = 1
y = 0

[State 52, Assert: NoWalk]
type = AssertSpecial
trigger1 = anim != 5
flag = NoWalk

[State 52, Landing Sound]
type = PlaySnd
trigger1 = !Time
value = 52,0

[State 52, Landing Dust Explod]
type = Explod
trigger1 = !Time
anim = 8102
sprPriority = -3
posType = P1
scale = 0.5,0.5
pauseMoveTime = -1
superMoveTime = -1
ownPal = 1

[State 52, ChangeAnim to Turning]
type = ChangeAnim
trigger1 = ctrl && P2Dist x < 0
trigger1 = Anim != 5
value = 5

[State 52, Turn]
type = Turn
trigger1 = Anim = 5 && AnimElem = 1

[State 52, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1
