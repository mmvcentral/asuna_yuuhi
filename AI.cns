[Statedef -3]


[State -1, AI]
type = VarSet
triggerall = var(59) != 1
triggerall = RoundState != 3
triggerall = !ishelper
trigger1 = ailevel
trigger2 = 0  ; Set to 1 for always-on AI regardless of ailevel (see README / docs/log.md)
;trigger3 = palno = 1
var(59) = 1
ignorehitpause = 1


[State -1, StrongMode toggle]
type = Varset
trigger1 = 0 ;On=1 Off=0
trigger2 = palno >=9 ; tied to palette / P-switch strength
var(22) = 1

;
[State 0, BY]
type = NotHitBy
trigger1 = movetype= A && TIME <= 9
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
ignorehitpause = 1

[State 0, PowerAdd]
type = PowerAdd
trigger1 = movetype= A && TIME = 1
value = 90
ignorehitpause = 1

[State 0,Life-based damage scaling check]
type = AttackMulSet
triggerall = Roundstate != 2
trigger1 = Enemy,life>=1500
value = 1

[State 0,Life-based damage scaling check]
type = AttackMulSet
triggerall = Roundstate != 2
trigger1 = Enemy,life>=2000
value = 10


[State 0, P4+ auto meter]
type = PowerAdd
trigger1 = palno >=4
trigger1 = (GameTime%4) = 1
value = 4
ignorehitpause = 1

[State 0, P5+ attack invuln]
type = NotHitBy
trigger1 = palno >=5
trigger1 = movetype= A
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
ignorehitpause = 1

[State ,P7+ low-HP defence scaling]
type = DefenceMulSet
trigger1 = palno >=7
trigger1 = 1
value = 1-(1-((life+0.0)/lifemax+0.0))
ignorehitpause = 1

[State 0,P6+ damage multiplier tiers]
type = AttackMulSet
trigger1 =palno >=6
value = 1

[State 0,P6+ damage multiplier tiers]
type = AttackMulSet
trigger1 =palno >=8
value = 2

[State 0,P6+ damage multiplier tiers]
