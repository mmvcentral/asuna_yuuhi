; Japanese victory quotes — English gloss: docs/TRANSLATION.md
[ja.Quotes]
victory0 = "私は戦う……最後の瞬間まで自分のままでいるために……。"
victory1 = "血盟騎士団、副団長の名にかけて……負けられない！"
victory2 = "じゃ、街に戻ってご飯にしましょうか。"
victory3 = "なかなか手強い相手だったな……こちらも戦闘スキルをもっと上げていかないと……。"
victory4 = "戦うのは好きじゃないけれど……今はそんな綺麗事、言ってられないようね……。"
; vs Kirito
victory5 = "豪華でロマンティックなディナー、期待してるわよ、キリト君？"
victory6 = "キリト君までこの世界に……？お願い、無事でいてね……。"
; vs Yuuki
victory7 = "前の時よりもずっと腕をあげてる……！\n今回はなんとか勝てたけど、次こそもう危ないわ。"
; vs Ako
victory8 = "す、すごい相手だったな……\nあの星型のロッド……しばらく夢に出てきそうな気がするよ。"
; vs Kuroyukihime (black palette tropes)
victory9 = "なんだかキリト君に会いたくなっちゃったな。"