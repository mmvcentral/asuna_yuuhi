;English (quotes)
[Quotes]
victory0 = "I will fight to keep myself till the last moment."
victory1 = "As sub-leader of the Knights of the Blood... I will not lose!"
victory2 = "Let's head back to town and grab a bite."
victory3 = "You were formidable opponent. I must also more raise the battle skills."
victory4 = "I really don't like to fight. But this isn't the time to worry about that."
;Kirito
victory5 = "I'm expecting a romantic dinner in luxury, Kirito-kun?"
victory6 = "You also it is in this world!? Please, I want you to have a safe."
;Yuuki
